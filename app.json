{
  "expo": {
    "name": "FinTrack",
    "slug": "FinTrack-Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fintrackfrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yeaminfoysal.fintrack"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E7A52",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yeaminfoysal.fintrack"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7A52",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0E7A52"
          }
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fe9edd8-5c38-4bdc-b5eb-461dd709e136"
      }
    }
  }
}
