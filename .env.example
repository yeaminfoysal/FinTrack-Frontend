# Backend base URL. The API client appends "/api" automatically.
# Do NOT include a trailing slash and do NOT add "/api" here.
#
# Phone / emulator-এ "localhost" কাজ করবে না — মেশিনের LAN IP দিন।
#   Windows-এ IP দেখতে:  ipconfig  →  IPv4 Address
#
# Examples:
#   EXPO_PUBLIC_API_URL=http://192.168.0.105:3000      # ফোন/এমুলেটর (LAN)
#   EXPO_PUBLIC_API_URL=http://localhost:3000          # শুধু web browser
#   EXPO_PUBLIC_API_URL=https://fintrack.example.com   # deployed backend

EXPO_PUBLIC_API_URL=http://localhost:3000
